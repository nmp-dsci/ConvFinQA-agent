# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


# Virtual environments
.env
.venv

# Jupyter Notebook
.ipynb_checkpoints

# macOS
.DS_Store

.*cache

# Evaluation outputs (predictions CSVs, HTML reports) and GEPA artifacts
# are TRACKED so cached results reproduce across machines without re-running.
# Local-only DSPy LM cache (~366 MB) stays out — sync via rsync if needed:
#   rsync -av .dspy_cache/ user@vm:~/ConvFinQA-agent/.dspy_cache/
.dspy_cache/

# MLflow file store. The live tracking store is dev state; what ships is the
# committed export (evaluation/mlflow_snapshot.json), regenerated by
# `convfinqa-mlflow snapshot`.
mlruns/

# Run-trace store: per-turn stage IO captured while serving. Dev state, and
# it grows without bound — the demo ships baked packs instead.
.traces/

# Node
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/*.tsbuildinfo

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraform.lock.hcl

# Compiled Python
*.egg-info/
build/
dist/
